# Copy to .env and fill in. Never commit .env.
#
# The double underscore is .NET's configuration separator: Oura__ClientId binds to the
# Oura:ClientId setting. Compose passes these straight through to both containers.

# ---------------------------------------------------------------------------
# Oura application credentials
#
# Register at https://developer.ouraring.com (https://cloud.ouraring.com/oauth/applications
# also works; which one is canonical is unclear). Free, no approval needed for personal use --
# unapproved apps are capped at 10 users, which is 9 more than this needs.
#
# OAuth2 authorization-code flow only. Personal Access Tokens were deprecated in December 2025
# and there is no PAT code path in this repo.
# ---------------------------------------------------------------------------
Oura__ClientId=
Oura__ClientSecret=

# Must match a redirect URI registered with the app *exactly* -- Oura allowlists them verbatim.
# Multiple URIs are supported, so registering both a localhost one for the first handshake and
# the real hostname is fine.
Oura__RedirectUri=http://localhost:8080/oauth/callback

# Space-separated. `email` is deliberately not requested.
#
# These are the names Oura's API enforces, established by reading its 401 bodies -- NOT the ones
# the OpenAPI spec declares. The spec says `spo2Daily` (wrong) and does not mention `stress` or
# `heart_health` at all. The authorize endpoint silently ignores scope names it does not
# recognise, so a wrong entry here consents cleanly and then 401s four collections.
Oura__Scopes=personal daily heartrate workout tag session spo2 stress heart_health ring_configuration

# Earliest day the backfill asks for. Oura returns empty pages before the ring existed, so this
# only bounds how much empty range gets walked -- set it near when you got the ring.
Oura__BackfillFrom=2020-01-01

# Days of already-ingested history the reconcile job re-fetches each run. Oura amends recent
# days (a bedtime edit rewrites a sleep period), so this is not optional.
Oura__ReconcileTrailingDays=7

# Point the client at https://api.ouraring.com/v2/sandbox/... instead. Needs no credentials and
# returns fabricated data -- read docs/oura-api-notes.md before trusting any of it.
Oura__UseSandbox=false

# ---------------------------------------------------------------------------
# Postgres / TimescaleDB
# ---------------------------------------------------------------------------
POSTGRES_DB=oura
POSTGRES_USER=oura
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
API_PORT=8080
MCP_PORT=8081
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Container timezone. Oura interprets date query parameters in the *user's* local timezone, and
# `daily` rows are keyed on Oura's own `day` value, so this only affects log timestamps and the
# worker's idea of "today".
# ---------------------------------------------------------------------------
TZ=Europe/Kyiv

# ---------------------------------------------------------------------------
# Context — the half of the warehouse Oura cannot see.
#
# Calendar feeds are iCalendar URLs, NOT the Google Calendar API. Google publishes a private
# "Secret address in iCal format" per calendar (Settings -> your calendar -> Integrate calendar);
# that URL is itself a credential, so it belongs here and nowhere else. Using it avoids a second
# OAuth client with a second rotating refresh token, to read data already published as a file.
#
# The cost is freshness: Google regenerates these on its own schedule, sometimes hours behind.
# Irrelevant here, since Oura's nightly data does not land until mid-morning anyway.
#
# Indexed, so add a second feed as Context__Calendars__1__*.
# ---------------------------------------------------------------------------
Context__Calendars__0__Name=work
Context__Calendars__0__Url=
Context__Calendars__0__Kind=meeting
# Substring matches, case-insensitive — the all-day "week 32" and birthday noise.
Context__Calendars__0__ExcludeContaining__0=birthday
Context__Calendars__0__ExcludeContaining__1=out of office

# How often the feeds are re-read.
Context__Interval=03:00:00
Context__LookbackDays=400
Context__TimeZone=Europe/Kyiv
